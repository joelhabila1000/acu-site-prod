# Local development database (MySQL / MariaDB).
# With XAMPP the port is 3380; a standalone MySQL install is usually 3306.
DATABASE_URL="mysql://user:password@127.0.0.1:3380/acu_cms"

# Signing key for admin sessions — generate a fresh one for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change_this_to_a_secure_random_value"

# Comma-separated origins allowed to call the API (your live site URL).
# Leave blank in local dev to allow all origins.
CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# Public URL of THIS API. Uploads are returned as absolute URLs against it, so
# browsers load them from the API host rather than the site host. Set this in
# production (e.g. https://api.your-domain.com); when unset the URL is derived
# from the incoming request.
# PUBLIC_BASE_URL="https://api.your-domain.com"

# Set when running behind a reverse proxy (Hostinger/nginx) so the real client
# IP is used for rate limiting and req.protocol is correct. Leave unset locally.
# TRUST_PROXY=1

# Where uploaded images are written. Defaults to <repo>/uploads.
# Point this at a folder outside the deploy directory when going live.
# UPLOAD_DIR="/home/username/uploads"

# Upload size limits in MB. Images default to 4, documents (reports) to 20.
# UPLOAD_MAX_MB=4
# UPLOAD_DOC_MAX_MB=20

PORT=4000
