# Database — PostgreSQL (Neon on Vercel).
# DATABASE_URL is the connection string the app uses at runtime. On Neon the
# "-pooler" host is fine (add pgbouncer=true&connection_limit=1 for serverless).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/acu_cms?sslmode=require&pgbouncer=true&connection_limit=1"

# Signing key for admin sessions — generate a fresh one for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change_this_to_a_secure_random_value"

# Comma-separated origins allowed to call the API (your live site URL).
# Leave blank in local dev to allow all origins.
CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# Public URL of THIS API. Uploads are returned as absolute URLs against it, so
# browsers load them from the API host rather than the site host. Set this in
# production (e.g. https://your-api.vercel.app); when unset the URL is derived
# from the incoming request.
# PUBLIC_BASE_URL="https://your-api.vercel.app"

# Set when running behind a reverse proxy so the real client IP is used for rate
# limiting and req.protocol is correct. On Vercel set TRUST_PROXY=true (or 1).
# TRUST_PROXY=true

# Vercel Blob: when set, uploads are written to Blob storage instead of local
# disk. Required on Vercel, where the filesystem is read-only outside /tmp.
# Create a Blob store in the Vercel project to get this token.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Where uploaded files are written when Blob is NOT configured. Defaults to
# <repo>/uploads. Point this at a persistent folder when hosting on a VM.
# UPLOAD_DIR="/home/username/uploads"

# Upload size limits in MB. Images default to 10, documents (reports) to 20.
# When BLOB_READ_WRITE_TOKEN is set, uploads go browser→Blob via
# POST /api/uploads/client and these caps are enforced by the issued token.
# UPLOAD_MAX_MB=10
# UPLOAD_DOC_MAX_MB=20

PORT=4000
