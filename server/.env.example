DATABASE_URL="postgresql://user:password@localhost:5432/acu_cms?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/acu_cms?schema=public"
AUTH_SECRET="change_this_to_a_secure_random_value"
# Comma-separated origins allowed to call the API (your Hostinger site URL).
# Leave blank in local dev to allow all origins.
CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"
STORAGE_PROVIDER="local"
STORAGE_PATH="./uploads"
# Set on Vercel to store uploads in Vercel Blob (leave blank for local dev)
BLOB_READ_WRITE_TOKEN=""
PORT=4000
