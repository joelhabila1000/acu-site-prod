generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL (Neon on Vercel). DATABASE_URL is a Neon Postgres connection
  // string; the "-pooler" host is fine for the serverless runtime.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  passwordHash String
  roleId      Int
  role        Role     @relation(fields: [roleId], references: [id])
  status      String   @default("active")
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ActivityLog ActivityLog[]
  pages       Page[]
  news        News[]
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  rolePermissions RolePermission[]
}

// Reserved: the API currently authorises by role *name* (see src/lib/roles.js),
// so these permission tables are not yet wired into any request path.
model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  rolePermissions RolePermission[]
}

model RolePermission {
  id           Int @id @default(autoincrement())
  role         Role @relation(fields: [roleId], references: [id])
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int
}

model Page {
  id           Int @id @default(autoincrement())
  title        String
  slug         String @unique
  content      String @db.Text
  featuredImage String?
  status       String @default("draft")
  authorId     Int
  author       User @relation(fields: [authorId], references: [id])
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model News {
  id           Int @id @default(autoincrement())
  title        String
  slug         String @unique
  excerpt      String? @db.Text
  content      String @db.Text
  featuredImage String?
  // Extra photographs for the article: [{ url, caption }]
  images       Json?
  category     String?
  authorId     Int
  author       User @relation(fields: [authorId], references: [id])
  status       String @default("draft")
  featured     Boolean @default(false)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id          Int @id @default(autoincrement())
  title       String
  description String @db.Text
  image       String?
  // Extra photographs from the event: [{ url, caption }]
  images      Json?
  eventDate   DateTime
  startTime   String?
  endTime     String?
  venue       String?
  status      String @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faculty {
  id Int @id @default(autoincrement())
  name String
  slug String @unique
  description String? @db.Text
  tagline String?
  summary String? @db.Text
  dean String?
  image String?
  programmes Json?
  researchAreas Json?
  highlights Json?
  facilities Json?
  careerOutcomes Json?
  sortOrder Int @default(0)
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  departments Department[]
  programmesList Programme[]
}

model PrincipalOfficer {
  id Int @id @default(autoincrement())
  slug String @unique
  name String
  role String
  image String?
  summary String? @db.Text
  bio Json?
  qualifications Json?
  memberships Json?
  sortOrder Int @default(0)
  status String @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id Int @id @default(autoincrement())
  key String @unique
  value Json
  updatedAt DateTime @updatedAt
}

model Department {
  id Int @id @default(autoincrement())
  facultyId Int
  faculty Faculty @relation(fields:[facultyId], references:[id])
  name String
  slug String @unique
  description String? @db.Text
  headOfDepartment String?
  email String?
  phone String?
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  programmes Programme[]
}

model Programme {
  id Int @id @default(autoincrement())
  facultyId Int
  faculty Faculty @relation(fields:[facultyId], references:[id])
  departmentId Int?
  department Department? @relation(fields:[departmentId], references:[id])
  name String
  slug String @unique
  degreeType String?
  description String? @db.Text
  requirements String? @db.Text
  duration String?
  programmeType String?
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id Int @id @default(autoincrement())
  title String?
  name String
  slug String @unique
  profileImage String?
  position String?
  // "academic" (teaching) or "non-academic" (ICT, bursary, bookshop, …)
  staffType String @default("academic")
  facultyId Int?
  departmentId Int?
  // Place of work for non-academic staff, who have no faculty or department.
  unit String?
  biography String? @db.Text
  email String?
  phone String?
  linkedin String?
  orcid String?
  googleScholar String?
  scopus String?
  researchGate String?
  academia String?
  webOfScience String?
  ssrn String?
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryAlbum {
  id Int @id @default(autoincrement())
  name String
  slug String? @unique
  description String? @db.Text
  coverImage String?
  sortOrder Int @default(0)
  status String @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images GalleryImage[]
}

model GalleryImage {
  id Int @id @default(autoincrement())
  albumId Int
  album GalleryAlbum @relation(fields:[albumId], references:[id], onDelete: Cascade)
  imageUrl String
  caption String? @db.Text
  sortOrder Int @default(0)
  uploadedBy Int?
  createdAt DateTime @default(now())
}

model Document {
  id Int @id @default(autoincrement())
  title String
  description String? @db.Text
  category String?
  fileUrl String
  fileName String
  fileType String
  fileSize Int
  uploadedBy Int?
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InauguralLecture {
  id           Int       @id @default(autoincrement())
  number       Int
  lecturer     String?
  lecturerRole String?
  title        String?
  summary      String?   @db.Text
  lectureDate  DateTime?
  venue        String?
  fileUrl      String?
  status       String    @default("published")
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Announcement {
  id Int @id @default(autoincrement())
  title String
  content String @db.Text
  priority Int @default(1)
  status String @default("draft")
  publishedAt DateTime?
  expiresAt DateTime?
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostgraduateProgramme {
  id        Int      @id @default(autoincrement())
  name      String
  // Award route, e.g. "PGD", "M.Sc.", "MBA", "Ph.D." — used for grouping.
  award     String
  faculty   String
  status    String   @default("published")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  programme String?
  subject   String?
  message   String   @db.Text
  // Which form it came from: "contact" or "admissions".
  source    String   @default("contact")
  status    String   @default("new")
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageSetting {
  id Int @id @default(autoincrement())
  key String @unique
  value String @db.Text
  updatedAt DateTime @updatedAt
}

model ContactInfo {
  id Int @id @default(autoincrement())
  address String? @db.Text
  phone String?
  email String?
  social Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id Int @id @default(autoincrement())
  userId Int?
  action String
  entity String
  entityId Int?
  description String? @db.Text
  createdAt DateTime @default(now())
  user User? @relation(fields:[userId], references:[id])
}

model Publication {
  id              Int      @id @default(autoincrement())
  title           String
  // Comma-separated author names, in the order they should be displayed.
  authors         String   @db.Text
  // Journal article | Book | Book chapter | Conference paper | Thesis
  publicationType String   @default("Journal article")
  venue           String?
  year            Int?
  volume          String?
  issue           String?
  pages           String?
  doi             String?
  url             String?
  abstract        String?  @db.Text
  faculty         String?
  fileUrl         String?
  featured        Boolean  @default(false)
  status          String   @default("published")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ------------------------------------------------------------- Hostel portal

model Hostel {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  // male | female | mixed — used to filter what a student may apply for.
  gender       String   @default("mixed")
  description  String?  @db.Text
  image        String?
  location     String?
  status       String   @default("active")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rooms        Room[]
  applications HostelApplication[]
}

model Room {
  id           Int      @id @default(autoincrement())
  hostelId     Int
  hostel       Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int      @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  beds         Bed[]
  applications HostelApplication[]
  maintenance  MaintenanceRequest[]
}

model Bed {
  id           Int      @id @default(autoincrement())
  roomId       Int
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label        String
  // available | occupied | maintenance
  status       String   @default("available")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applications HostelApplication[]
  maintenance  MaintenanceRequest[]
}

model StudentAccount {
  id           Int       @id @default(autoincrement())
  name         String
  matricNumber String    @unique
  email        String    @unique
  passwordHash String
  phone        String?
  gender       String?
  level        String?
  department   String?
  status       String    @default("active")
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  applications HostelApplication[]
  payments     HostelPayment[]
  maintenance  MaintenanceRequest[]
}

model HostelApplication {
  id              Int             @id @default(autoincrement())
  studentId       Int
  student         StudentAccount  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostelId        Int?
  hostel          Hostel?         @relation(fields: [hostelId], references: [id])
  roomId          Int?
  room            Room?           @relation(fields: [roomId], references: [id])
  bedId           Int?
  bed             Bed?            @relation(fields: [bedId], references: [id])
  session         String
  // pending | approved | rejected | allocated | checked_in | checked_out
  status          String          @default("pending")
  preferredGender String?
  notes           String?         @db.Text
  adminNote       String?         @db.Text
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  payments        HostelPayment[]
}

model HostelPayment {
  id            Int               @id @default(autoincrement())
  studentId     Int
  student       StudentAccount    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationId Int?
  application   HostelApplication? @relation(fields: [applicationId], references: [id])
  // Whole naira; the portal tracks status rather than processing card payments.
  amount        Int               @default(0)
  reference     String?
  method        String?
  // pending | paid | failed
  status        String            @default("pending")
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model MaintenanceRequest {
  id          Int             @id @default(autoincrement())
  studentId   Int?
  student     StudentAccount? @relation(fields: [studentId], references: [id])
  roomId      Int?
  room        Room?           @relation(fields: [roomId], references: [id])
  bedId       Int?
  bed         Bed?            @relation(fields: [bedId], references: [id])
  category    String          @default("general")
  description String          @db.Text
  priority    String          @default("normal")
  // open | in_progress | resolved
  status      String          @default("open")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// Institutional repository — theses, articles, conference papers, books,
// reports and datasets deposited by library staff, with an optional full-text
// file hosted by the site.
model RepositoryItem {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  itemType    String
  authors     String
  abstract    String?   @db.Text
  keywords    String?
  faculty     String?
  department  String?
  year        Int?
  degree      String?
  supervisor  String?
  publisher   String?
  doi         String?
  language    String?   @default("English")
  fileUrl     String?
  fileName    String?
  fileType    String?
  fileSize    Int?
  featured    Boolean   @default(false)
  // published | hidden
  status      String    @default("published")
  publishedAt DateTime?
  uploadedBy  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// -------------------------------------------------------------- University Library
// The library runs on its own subdomain (library.acu.edu.ng) but shares this
// API and database with the main site.

model LibraryBranch {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  campus    String?
  address   String?  @db.Text
  phone     String?
  email     String?
  mapEmbed  String?  @db.Text
  image     String?
  // Opening hours: [{ day, opens, closes }]
  hours     Json?
  sortOrder Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  holdings  LibraryBook[]
}

model LibraryBook {
  id              Int            @id @default(autoincrement())
  title           String
  slug            String         @unique
  authors         String
  isbn            String?
  publisher       String?
  publishedYear   Int?
  edition         String?
  // Book | Journal | Reference | Thesis | Project | E-book
  resourceType    String         @default("Book")
  subject         String?
  callNumber      String?
  description     String?        @db.Text
  coverImage      String?
  language        String?        @default("English")
  branchId        Int?
  branch          LibraryBranch? @relation(fields: [branchId], references: [id])
  // available | reference | on-loan | withdrawn
  availability    String         @default("available")
  copies          Int            @default(1)
  availableCopies Int            @default(1)
  fileUrl         String?
  fileName        String?
  fileType        String?
  fileSize        Int?
  externalUrl     String?
  featured        Boolean        @default(false)
  sortOrder       Int            @default(0)
  // published | hidden
  status          String         @default("published")
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model LibraryEResource {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  provider    String?
  // Database | E-journal | E-book | Open access | Repository | Other
  category    String   @default("Database")
  description String?  @db.Text
  accessUrl   String
  accessNote  String?
  logo        String?
  status      String   @default("published")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LibraryService {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  summary     String?
  description String?  @db.Text
  icon        String?
  sortOrder   Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
