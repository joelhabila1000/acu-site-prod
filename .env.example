# Site build-time configuration (Vite).
#
# VITE_API_BASE — base URL of the CMS API.
#   Leave blank when the API is served from the same origin as the site
#   (e.g. everything on one Vercel project, or local dev).
#   Set it when the static site is hosted separately from the API
#   (e.g. site on Hostinger, API on Vercel):
#
# VITE_API_BASE=https://your-api-project.vercel.app
VITE_API_BASE=
